{
  "expo": {
    "name": "MovenApp",
    "slug": "moven",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "movenapp",
    "jsEngine": "hermes",
    "android": {
      "package": "com.lipevidal.moven"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Permita que o MovenApp acesse seu microfone para enviar mensagens de áudio.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9086fc2e-9b73-40df-ab7e-472b48cc90b8"
      }
    }
  }
}
